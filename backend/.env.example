# Postgres connection. DB_URL carries only host/port/database — credentials are
# supplied per role below, and the async driver is added by app/config.py.
# The conjugation database and the conjugation_app / conjugation_owner roles
# must already exist (see dbeaver/create_users_and_db.sql + grant_privileges.sql).
DB_URL=postgresql://localhost:5432/conjugation

# App role: everything a request does (CRUD only, no DDL).
DB_USER=conjugation_app
DB_PASSWORD=

# Owner role: used at startup to create the tables and refresh the seed data.
DB_OWNER_USER=conjugation_owner
DB_OWNER_PASSWORD=

# Browser origins allowed to call this service directly, comma-separated. Only
# relevant for direct calls: in the deployment nginx proxies /api same-origin,
# so no CORS check happens there. Defaults to the Angular dev server.
CORS_ORIGINS=http://localhost:4200

# Where the vocabulary JSON lives (defaults to <repo>/data/vocabulary).
# VOCABULARY_DIR=../data/vocabulary
